// Copy this file to env.js and fill in your values.
// env.js is gitignored — never commit it.
window._ENV = {
  // Backend API URL
  API: '',              // e.g. https://api.yourdomain.dev  |  local: http://localhost:8000

  // Identity — shown on the whoami card and in the terminal UI
  OWNER_NAME: '',       // e.g. Jane Doe
  OWNER_HANDLE: '',     // e.g. janedoe  (used in the PS1 prompt)
  OWNER_ROLE: '',       // e.g. Backend Engineer
  OWNER_SPECIALTY: '',  // e.g. distributed systems, Go, Postgres  (shown as a comment)
  OWNER_ENV: 'terminal-only',
  OWNER_ENV_COMMENT: 'no GUI, no mercy',
  OWNER_DOMAIN: '',     // e.g. janedoe.dev

  // Chat UI
  CHAT_HINT: '',        // e.g. "ask me anything — I'll answer as Jane"
  CHAT_PLACEHOLDER: '', // e.g. "what are you working on right now?"

  // Social links
  GITHUB_URL: '',       // e.g. https://github.com/janedoe
  LINKEDIN_URL: '',     // e.g. https://linkedin.com/in/janedoe
};
