# ── API Keys ────────────────────────────────────────────────────────────────
GEMINI_API_KEYS=key1,key2
GROQ_API_KEYS=key1,key2

# ── AI Model Names ───────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-8b-instant

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_SECRET=change_this_to_a_random_string
ADMIN_COOKIE_DAYS=30

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_DAY=20

# ── Public Identity ───────────────────────────────────────────────────────────
GITHUB_USERNAME=
ALLOWED_ORIGIN=

# ── Context Encryption ────────────────────────────────────────────────────────
CONTEXT_ENCRYPTION_KEY=choose_a_strong_passphrase_here

# ── Umami Analytics ───────────────────────────────────────────────────────────
UMAMI_SECRET=change_this_too
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── Modal / SLM ───────────────────────────────────────────────────────────────
MODAL_ENDPOINT=
MODAL_ENABLED=true
MODAL_VOLUME_NAME=
MODAL_MEMORY=4096
MODAL_TIMEOUT=120
SLM_TIMEOUT=90

# ── HuggingFace Model ─────────────────────────────────────────────────────────
HF_REPO_ID=
HF_FILENAME=

# ── LLM Inference Params ──────────────────────────────────────────────────────
LLM_N_CTX=4096
LLM_N_THREADS=4
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3

# ── SLM System Prompt (used by Modal cloud function) ─────────────────────────
SLM_SYSTEM_PROMPT=
